ll_name": "Christos Gkemisis", "first_name": "Christos", "last_name": "Gkemisis", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9889-8036"}, {"id": 22180839, "full_name": "Greet Bervoets", "first_name": "Greet", "last_name": "Bervoets", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2416-7246"}, {"id": 22180585, "full_name": "No-Joon Song", "first_name": "No-Joon", "last_name": "Song", "is_active": false, "url_name": "_", "orcid_id": "0009-0002-0947-0597"}, {"id": 22180842, "full_name": "Ayse Bassez", "first_name": "Ayse", "last_name": "Bassez", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-0432-1536"}, {"id": 22180845, "full_name": "Robin Browaeys", "first_name": "Robin", "last_name": "Browaeys", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2934-5195"}, {"id": 22180848, "full_name": "Lotte Pollaris", "first_name": "Lotte", "last_name": "Pollaris", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9509-9386"}, {"id": 14957565, "full_name": "Francesca M. Bosisio", "first_name": "Francesca M.", "last_name": "Bosisio", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-8874-2003"}, {"id": 21652502, "full_name": "Veerle Boecxstaens", "first_name": "Veerle", "last_name": "Boecxstaens", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-5238-2619"}, {"id": 12097448, "full_name": "Yvan Saeys", "first_name": "Yvan", "last_name": "Saeys", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-0415-1506"}, {"id": 15023694, "full_name": "Diether Lambrechts", "first_name": "Diether", "last_name": "Lambrechts", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3429-302X"}, {"id": 11930245, "full_name": "Zihai Li", "first_name": "Zihai", "last_name": "Li", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4603-927X"}, {"id": 18407343, "full_name": "Patrick Matthys", "first_name": "Patrick", "last_name": "Matthys", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9685-6836"}, {"id": 14957562, "full_name": "Oliver Bechter", "first_name": "Oliver", "last_name": "Bechter", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-0667-3284"}, {"id": 14957550, "full_name": "Jean-Christophe Marine", "first_name": "Jean-Christophe", "last_name": "Marine", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2433-9837"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Immune checkpoint blockade (ICB) has revolutionized cancer treatment. Unfortunately, the inability of lymphocytes to infiltrate the tumor nest, a phenomenon known as immune exclusion, drastically limits ICB responsiveness. Analyzing the immune landscape of matched pre- and early on-treatment biopsies of patients with melanoma undergoing ICB therapy, we observed a significant increase in cytotoxic NK cells in early on-treatment biopsies from nonresponders. Spatial multiomic analyses revealed that, although NK cells colocalized with CD8+ T cells within the tumor bed in responding lesions, they were excluded from the tumor parenchyma in nonresponding lesions. Strikingly, pharmacologic depletion of NK cells in a unique melanoma mouse model exhibiting an immune-excluded phenotype unleashed immune infiltration of the tumor core and tumor clearance upon ICB exposure. Mechanistically, we show that NK cells are actively recruited to immune-excluded areas upon ICB exposure via the chemokine receptor CX3CR1 to suppress tumor infiltration and antitumor function of CD8+ T cells.\nImmune exclusion is responsible for intrinsic resistance to ICB in about half of nonresponder patients. Our unexpected observation that targeting NK cell biology unleashes the recruitment and antitumor activity of CD8+ T cells in tumors with an immune-excluded phenotype offers a potential therapeutic avenue for this large patient population.See related commentary by Galvez-Cancino et al., p. 1777See related article by Song et al., p. 1835", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/dataset/Supplemental_Table_S1_from_Cytotoxic_NK_Cells_Impede_Response_to_Checkpoint_Immunotherapy_in_Melanoma_with_an_Immune-Excluded_Phenotype/30050748", "download_disabled": false, "description": "<p>Characteristics of patients for (A) scRNA-seq, (B) MILAN mIF samples, (C) FLOW cytometry of peripheral NK cells.</p>", "funding": "HORIZON EUROPE Marie Sklodowska-Curie Actions (MSCA)", "funding_list": [{"id": 23229458, "title": "HORIZON EUROPE Marie Sklodowska-Curie Actions (MSCA)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23229576, "title": "Stichting Tegen Kanker (Fondation Contre le Cancer)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23219187, "title": "Fonds Wetenschappelijk Onderzoek (FWO)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23229567, "title": "KU Leuven (Katholieke Universiteit Leuven)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23246865, "title": "The Research Foundation Flanders", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 29232036, "title": "FWO/KOTK", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 29232039, "title": "FWO-SBO", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 29232042, "title": "iBOF", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 29232045, "title": "FWO/FRS-FNRS", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 20976, "created_date": "2025-09-04T07:21:48Z", "modified_date": "2025-09-04T07:21:48Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/b