{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "VTSC dynamic melanoma recording v2",
  "required": [
    "schema_version",
    "kind",
    "config",
    "effective_model",
    "catalog",
    "frame_columns",
    "frames",
    "decisions",
    "events",
    "summary",
    "provenance",
    "parameter_ledger"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "vtsc_melanoma_run"
    },
    "frame_columns": {
      "const": [
        "index",
        "x",
        "y",
        "radius",
        "alive",
        "action",
        "target",
        "damage",
        "fatigue",
        "cycle",
        "cd8_state",
        "time_in_state",
        "dysfunction",
        "proliferation",
        "cytotoxicity",
        "persistence"
      ]
    },
    "catalog": {
      "type": "array"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "time_hours",
          "cells",
          "cue",
          "counts",
          "cd8_counts",
          "exposure"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell_id",
          "time_hours",
          "choice",
          "options",
          "context",
          "state_decision",
          "record_hash",
          "previous_hash",
          "journal_index"
        ]
      }
    },
    "events": {
      "type": "array"
    },
    "summary": {
      "type": "object",
      "required": [
        "seed",
        "complete",
        "stop_reason",
        "clinical_validation",
        "journal_root"
      ],
      "properties": {
        "clinical_validation": {
          "const": false
        }
      }
    }
  }
}
